<Window
    x:Class="LumaKnob.App.Views.TrayPanelWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LumaKnob.App.ViewModels"
    x:DataType="viewModels:MainWindowViewModel"
    Width="410"
    Height="430"
    CanResize="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowDecorations="None"
    Icon="/Assets/lumaknob.ico"
    Title="LumaKnob Quick Control"
    Background="#070909">
  <Window.Styles>
    <Style Selector="Button.panelButton">
      <Setter Property="Background" Value="#252C2E" />
      <Setter Property="Foreground" Value="#D8E0DC" />
      <Setter Property="BorderBrush" Value="#687477" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.panelCaption">
      <Setter Property="Foreground" Value="#8F9B96" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="Border.monitorRow">
      <Setter Property="Background" Value="#111718" />
      <Setter Property="BorderBrush" Value="#4F5B5E" />
      <Setter Property="BorderThickness" Value="2,2,1,1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="8,7" />
    </Style>
  </Window.Styles>

  <Border BorderBrush="#020303" BorderThickness="4" CornerRadius="7" Background="#080B0C">
    <Border Margin="2" BorderBrush="#657174" BorderThickness="1" CornerRadius="4" Background="#181E1F">
      <Grid RowDefinitions="34,Auto,*,Auto">
        <Border Grid.Row="0" Background="#30383A" BorderBrush="#697477" BorderThickness="0,0,0,1" CornerRadius="3,3,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,7,0">
            <Border Grid.Column="0" Width="9" Height="9" CornerRadius="5" Background="#A7ED79" BorderBrush="#E5FFD3" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="LUMAKNOB / QUICK CONTROL" Foreground="#E3EAE6" FontSize="11" FontWeight="Bold" LetterSpacing="1.3" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="panelButton" Content="×" Click="HidePanel" Width="28" Height="22" Padding="0" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="12,9,12,5">
          <TextBlock Grid.Column="0" Classes="panelCaption" Text="ALL MONITORS / SHARED STEP" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Classes="panelCaption" Text="STEP" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StepReadout}" Foreground="#F1B94C" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
            <Button Classes="panelButton" Command="{Binding DecreaseStepCommand}" IsEnabled="{Binding CanControl}" Width="34">
              <Path Width="10" Height="10" Stretch="Uniform" Fill="#D8E0DC" Data="M 1,5 L 11,5 L 11,7 L 1,7 Z" />
            </Button>
            <Button Classes="panelButton" Command="{Binding IncreaseStepCommand}" IsEnabled="{Binding CanControl}" Width="34">
              <Path Width="10" Height="10" Stretch="Uniform" Fill="#D8E0DC" Data="M 5,1 L 7,1 L 7,5 L 11,5 L 11,7 L 7,7 L 7,11 L 5,11 L 5,7 L 1,7 L 1,5 L 5,5 Z" />
            </Button>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,2,12,3">
          <ItemsControl ItemsSource="{Binding Displays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:DisplayControlViewModel">
                <Border Classes="monitorRow" Margin="0,0,0,7">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <Button
                        Grid.Row="0" Grid.Column="0" Classes="panelButton"
                        Command="{Binding SelectCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        ToolTip.Tip="Select for gamma, warmth, and physical brightness-button input.">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    </Button>
                    <Border Grid.Row="0" Grid.Column="1" Background="#06110B" BorderBrush="#050707" BorderThickness="3" CornerRadius="2" Padding="7,3" Margin="7,0,0,0">
                      <TextBlock Text="{Binding BrightnessReadout}" Foreground="#A7ED79" FontFamily="Consolas" FontWeight="Bold" FontSize="15" MinWidth="62" TextAlignment="Center" />
                    </Border>
                    <Slider
                        Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,2"
                        Minimum="{Binding MinimumBrightnessPercent}" Maximum="100"
                        SmallChange="{Binding StepPercent}" LargeChange="{Binding StepPercent}"
                        Value="{Binding BrightnessPercent, Mode=TwoWay}"
                        IsEnabled="{Binding CanControl}" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,3,0,0">
                      <Button Grid.Column="0" Classes="panelButton" Command="{Binding DecreaseBrightnessCommand}" IsEnabled="{Binding CanControl}" Width="34" Height="24" Padding="0">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#D8E0DC" Data="M 1,5 L 11,5 L 11,7 L 1,7 Z" />
                      </Button>
                      <Button Grid.Column="1" Classes="panelButton" Command="{Binding IncreaseBrightnessCommand}" IsEnabled="{Binding CanControl}" Width="34" Height="24" Padding="0" Margin="5,0,0,0">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#D8E0DC" Data="M 5,1 L 7,1 L 7,5 L 11,5 L 11,7 L 7,7 L 7,11 L 5,11 L 5,7 L 1,7 L 1,5 L 5,5 Z" />
                      </Button>
                      <TextBlock Grid.Column="3" Text="{Binding SelectionStatus}" Foreground="#78BFEF" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="12,5,12,11" VerticalAlignment="Bottom">
          <Button Grid.Column="0" Classes="panelButton" Content="OPEN CONTROL DECK" Click="OpenControlDeck" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" Classes="panelButton" Content="HIDE" Click="HidePanel" Margin="7,0,0,0" />
        </Grid>
      </Grid>
    </Border>
  </Border>
</Window>
